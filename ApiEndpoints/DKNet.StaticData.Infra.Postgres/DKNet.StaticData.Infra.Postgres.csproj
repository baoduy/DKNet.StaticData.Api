<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <LangVersion>default</LangVersion>
        <ImplicitUsings>true</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <!-- CA1861: dotnet ef generates the migrations with constant array arguments. -->
        <NoWarn>$(NoWarn);CA1861</NoWarn>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.EntityFrameworkCore.Design">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL"/>
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\DKNet.StaticData.Infra\DKNet.StaticData.Infra.csproj" />
    </ItemGroup>

    <ItemGroup>
        <!-- The architecture tests read the model through internal DbContextFactory. -->
        <InternalsVisibleTo Include="DKNet.StaticData.App.Tests"/>
    </ItemGroup>
</Project>
