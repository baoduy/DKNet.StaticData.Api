  "cards": [
    {
      "dot": "rose",
      "title": "Security",
      "items": [
        "Bearer token from client credentials only; no browser calls",
        "Scope or app role: files.read, files.write, settings.read, settings.write",
        "Owner travels as the owner query parameter; the owner filter fails closed"
      ]
    },
    {
      "dot": "emerald",
      "title": "Files",
      "items": [
        "Max 50,000,000 bytes per file; extension allow-list",
        "Bytes stream to and from storage; no download links",
        "X-Idempotency-Key on POST /v1/files and /v1/file-groups"
      ]
    },
    {
      "dot": "cyan",
      "title": "Configuration",
      "items": [
        "Database:Provider = Postgres (default) or SqlServer",
        "One blob provider per deployment: Local, AzureStorage or AwsS3",
        "GET /healthz anonymous; /healthz/detail needs a token"
      ]
    }
  ]
